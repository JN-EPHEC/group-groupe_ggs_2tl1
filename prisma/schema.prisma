generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Categorie {
  id_categorie  Int @id @default(autoincrement())
  nom String @unique
  description String?

  produits Produit[]
}

model Produit {
  id_produit  Int @id @default(autoincrement())
  nom String
  prix Decimal(10)
  description String?
  stock Int @default(0)
  image_url String

  categories Categorie[]
}

model Commande {
  id_commande Int @id @default(autoincrement())
  etat_commande DateTime  @default(now())
  prix  Decimal(10)
  adresse_livraison String

  statut Statut @relation(fields: [id_statut], references: [id_statut])
  id_statut Int

  id_client Int
  client Client @relation(fields: [id_client]), references: 
}


model Statut {
  id_statut Int @id @default(autoincrement())
  valeur String 

  commandes Commande[]
}