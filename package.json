  "scripts": {
    "setup": "npm install --prefix server && npm install --prefix client && prisma generate",
    "dev": "concurrently --kill-others-on-fail --names server,client --prefix-colors blue,magenta \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "start:server": "npm --prefix server run start",
    "start:client": "npm --prefix client run dev",
    "build": "npm --prefix server run build && npm --prefix client run build",
    "start:prod": "npm --prefix server run start:prod",
    "start:prod:all": "npm run build && npm run start:prod",
    "test": "jest",
    "prisma:generate:dev": "prisma generate",
    "prisma:generate:prod": "set APP_ENV=production&& prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "set APP_ENV=production&& prisma migrate deploy",
    "prisma:status:dev": "prisma migrate status",
    "prisma:status:prod": "set APP_ENV=production&& prisma migrate status"
